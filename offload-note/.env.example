# Postgres (Neon or Supabase, UK or EU region). Without it in development, a local database is used.
DATABASE_URL=

# First admin login, created on first run when there are no operatives yet.
# Use a role name such as "Office", not a personal name.
ADMIN_NAME=Office
ADMIN_PIN=

# Private S3-compatible bucket for PDFs, signatures and photos.
# Supabase Storage: S3_ENDPOINT=https://<project>.supabase.co/storage/v1/s3, S3_REGION=eu-west-2
# Cloudflare R2:    S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com, S3_REGION=auto (choose EU jurisdiction)
# AWS S3:           leave S3_ENDPOINT empty, S3_REGION=eu-west-2
S3_BUCKET=
S3_REGION=eu-west-2
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Resend, sending from notes@offloadwaste.com
RESEND_API_KEY=
